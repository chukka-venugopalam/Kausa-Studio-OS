# Copy to .env locally, and set the same values as GitHub Secrets for Actions.
# Never commit a real .env file -- .gitignore already excludes it.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Automated agents call Gemini specifically -- see lib/ai_client.py for why
# (Gemini has an ongoing free API tier; Claude and ChatGPT currently don't).
GEMINI_API_KEY=your-gemini-api-key

# Only needed by the publishing agent once you wire up real uploads.
YOUTUBE_API_KEY=
INSTAGRAM_GRAPH_API_TOKEN=

# Where n8n's error workflow sends failure alerts.
ALERT_WEBHOOK_URL=
